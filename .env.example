# Salin ke .env.local untuk pengembangan lokal. Di Vercel, isi lewat Project Settings -> Environment Variables.
# JANGAN commit file .env.* yang berisi nilai asli.

# --- Hanya untuk server (/api). Jangan beri awalan VITE_ ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Teks acak panjang (bebas) untuk menyamarkan IP/nomor di tabel rate limit
RATE_LIMIT_SALT=

# --- Boleh di frontend (tahap 3), keduanya publik ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
